    {
      "slug": "vyvar",
      "title": "Vývar",
      "excerpt": "Správně připravený vývar je jedním ze základních pilířů podpory trávení, střevní sliznice a mikrobiomu. Díky obsahu minerálů, aminokyselin, želatiny a kolagenu pomáhá při hojení propustného střeva a může výrazně podpořit léčbu ekzému a alergií. Důležitá je však délka vaření a správná volba surovin, zejména při histaminové zátěži.",
      "image": "https://a.storyblok.com/f/289317949964253/1536x1024/0209961900/broth.png",
      "imageAlt": "",
      "category": {
        "slug": "soups",
        "name": "Polévky"
      },
      "tags": [],
      "tagKeys": [],
      "servings": 4,
      "difficulty": "jednoduché",
      "activeMinutes": 10,
      "cookMinutes": 120,
      "totalMinutes": 130,
      "nutrition": {
        "kcal": 35,
        "protein": 5,
        "carbs": null,
        "fats": 2
      },
      "contains": [],
      "mayContain": [
        "beef",
        "poultry",
        "fish"
      ],
      "ingredients": [
        {
          "name": "Drůbež",
          "amount": "1",
          "unit": "porce",
          "note": "skelet, stehno, křídla, krk, pařáty",
          "optional": true,
          "linkedSlug": null
        },
        {
          "name": "Králík",
          "amount": "1",
          "unit": "porce",
